---
import Base from '../layouts/Base.astro';
import { claims, sources } from '../data/book';
import { editorialAudit } from '../data/editorialAudit';
import { withBase } from '../utils/paths';
const corrected=editorialAudit.filter(x=>x.result==='corrección documentada').length;
const caveats=editorialAudit.filter(x=>x.result==='confirmación con salvedades').length;
const pending=editorialAudit.filter(x=>x.result==='revisión pendiente').length;
const insufficient=editorialAudit.filter(x=>x.result==='evidencia insuficiente').length;
---
<Base title="Auditoría académica · Colombia compleja">
  <section class="chapter-hero"><div class="wrap"><nav class="breadcrumbs" aria-label="Migas"><ol><li><a href={withBase()}>Inicio</a></li><li aria-current="page">Auditoría académica</li></ol></nav><p class="eyebrow">Fase 4 · entrega 1</p><h1>Texto, evidencia y límite</h1><p class="lede">Matriz trazable de {claims.length} fichas y 11 pasajes: localización en la obra, comprobación externa, método, fecha y límites.</p><div class="meta-row"><span class="pill">{corrected} correcciones documentadas</span><span class="pill">{caveats} confirmaciones con salvedades</span><span class="pill">{insufficient} evidencias insuficientes</span>{pending>0&&<span class="pill">{pending} pendientes</span>}</div></div></section>
  <section class="section"><div class="wrap">
    <div class="grid two audit-guide"><article class="card"><h2>¿Qué se verifica?</h2><p><strong>Primero, el texto:</strong> qué escribió Carrizosa, en qué página y con qué referencia. <strong>Después, el hecho:</strong> qué permite sostener una fuente externa y bajo qué método. Son operaciones distintas.</p></article><article class="card"><h2>¿Cómo leer el resultado?</h2><p><strong>Cotejo documentado</strong> verifica una atribución textual. <strong>Confirmación con salvedades</strong> encuentra apoyo específico pero limitado. <strong>Corrección</strong> registra un cambio aplicado. <strong>Evidencia insuficiente</strong> evita convertir plausibilidad o relación indirecta en prueba.</p></article></div>
    <div class="notice"><strong>Independencia metodológica:</strong> el estado de una ficha expresa el contraste de la afirmación; esta matriz expresa la revisión editorial realizada. Ningún resultado se deriva automáticamente. “Documento citado” significa la obra nombrada por Carrizosa.</div>
    <div class="audit-controls"><label>Buscar registro <input id="audit-search" type="search" placeholder="censo, ENA, ecosistemas…" /></label><label>Resultado <select id="audit-result"><option value="all">Todos</option><option value="cotejo documentado">Cotejo documentado</option><option value="confirmación con salvedades">Confirmación con salvedades</option><option value="corrección documentada">Corrección documentada</option><option value="revisión pendiente">Revisión pendiente</option><option value="evidencia insuficiente">Evidencia insuficiente</option></select></label></div><p id="audit-count" aria-live="polite">{editorialAudit.length} registros.</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Matriz de auditoría académica"><table><thead><tr><th>Registro</th><th>Ubicación y resultado</th><th>Cotejo en el libro</th><th>Comprobación externa</th><th>Método y fecha</th><th>Fuentes</th><th>Incertidumbre y corrección</th></tr></thead><tbody>{editorialAudit.map(row=><tr id={row.recordId} data-audit-row data-result={row.result} data-search={`${row.recordId} ${row.bookCheck} ${row.externalCheck} ${row.uncertainty} ${row.correction}`.toLowerCase()}><th scope="row">{row.recordId}</th><td>p. {row.printedPage}<br/><small>PDF {row.pdfPage}</small><br/><span class="status">{row.result}</span></td><td>{row.bookCheck}</td><td>{row.externalCheck}</td><td>{row.method}<br/><small>{row.evidenceDate}</small></td><td><ul>{row.sourceIds.map(id=>{const source=sources.find(x=>x.id===id);return <li>{source?<a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>:id}</li>})}</ul></td><td><strong>Límite:</strong> {row.uncertainty}<br/><strong>Decisión:</strong> {row.correction}</td></tr>)}</tbody></table></div>
  </div></section>
  <script>const search=document.querySelector<HTMLInputElement>('#audit-search');const result=document.querySelector<HTMLSelectElement>('#audit-result');const update=()=>{let n=0;document.querySelectorAll<HTMLElement>('[data-audit-row]').forEach(row=>{const show=(!search?.value||row.dataset.search?.includes(search.value.toLowerCase()))&&(!result||result.value==='all'||row.dataset.result===result.value);row.hidden=!show;if(show)n++});const out=document.querySelector('#audit-count');if(out)out.textContent=`${n} registros.`};search?.addEventListener('input',update);result?.addEventListener('change',update);</script>
</Base>
<style>.audit-guide{margin-bottom:1rem}.audit-controls{display:grid;grid-template-columns:2fr 1fr;gap:1rem;margin:1.5rem 0}.audit-controls label{display:grid;gap:.4rem;font-weight:700}.audit-controls input,.audit-controls select{padding:.7rem;border:1px solid #aaa;border-radius:.35rem;background:white}td{min-width:12rem;vertical-align:top}td:nth-child(3),td:nth-child(4),td:nth-child(5),td:nth-child(7){min-width:20rem}td ul{padding-left:1rem;margin:0}@media(max-width:700px){.audit-controls{grid-template-columns:1fr}}</style>
