---
import Base from '../layouts/Base.astro';
import { claims } from '../data/book';
import { editorialAudit } from '../data/editorialAudit';
import { withBase } from '../utils/paths';
const corrected=editorialAudit.filter(x=>x.result==='corrección documentada').length;
const caveats=editorialAudit.filter(x=>x.result==='confirmación con salvedades').length;
const pending=editorialAudit.filter(x=>x.result==='revisión pendiente'||x.result==='evidencia insuficiente').length;
---
<Base title="Auditoría editorial · Colombia compleja">
  <section class="chapter-hero"><div class="wrap"><nav class="breadcrumbs" aria-label="Migas"><ol><li><a href={withBase()}>Inicio</a></li><li aria-current="page">Auditoría editorial</li></ol></nav><p class="eyebrow">Fase 3 · entrega 5</p><h1>Qué se revisó y qué cambió</h1><p class="lede">Matriz trazable de {claims.length} fichas y 11 pasajes: página impresa, posición PDF, evidencia, relación de la fuente y corrección.</p><div class="meta-row"><span class="pill">{corrected} correcciones</span><span class="pill">{caveats} confirmaciones con salvedades</span><span class="pill">{pending} pendientes o insuficientes</span></div></div></section>
  <section class="section"><div class="wrap"><div class="notice"><strong>Dos evaluaciones distintas:</strong> el estado de una ficha expresa el contraste de la afirmación. El resultado de esta matriz expresa qué revisión editorial se documentó; nunca se deriva automáticamente del primero. “Documento citado” significa la obra nombrada por Carrizosa.</div><div class="audit-controls"><label>Buscar registro <input id="audit-search" type="search" placeholder="censo, ENA, ecosistemas…" /></label><label>Resultado <select id="audit-result"><option value="all">Todos</option><option value="cotejo documentado">Cotejo documentado</option><option value="confirmación con salvedades">Confirmación con salvedades</option><option value="corrección documentada">Corrección documentada</option><option value="revisión pendiente">Revisión pendiente</option><option value="evidencia insuficiente">Evidencia insuficiente</option></select></label></div><p id="audit-count" aria-live="polite">{editorialAudit.length} registros.</p><div class="table-scroll" tabindex="0"><table><thead><tr><th>Registro</th><th>Ubicación</th><th>Resultado de auditoría</th><th>Evidencia</th><th>Relación de fuente</th><th>Corrección o pendiente</th></tr></thead><tbody>{editorialAudit.map(row=><tr data-audit-row data-result={row.result} data-search={`${row.recordId} ${row.evidence} ${row.correction}`.toLowerCase()}><th scope="row">{row.recordId}</th><td>p. {row.printedPage}<br/><small>PDF {row.pdfPage}</small></td><td><span class="status">{row.result}</span></td><td>{row.evidence}</td><td>{row.sourceRelation}</td><td>{row.correction}</td></tr>)}</tbody></table></div></div></section>
  <script>const search=document.querySelector<HTMLInputElement>('#audit-search');const result=document.querySelector<HTMLSelectElement>('#audit-result');const update=()=>{let n=0;document.querySelectorAll<HTMLElement>('[data-audit-row]').forEach(row=>{const show=(!search?.value||row.dataset.search?.includes(search.value.toLowerCase()))&&(!result||result.value==='all'||row.dataset.result===result.value);row.hidden=!show;if(show)n++});const out=document.querySelector('#audit-count');if(out)out.textContent=`${n} registros.`};search?.addEventListener('input',update);result?.addEventListener('change',update);</script>
</Base>
<style>.audit-controls{display:grid;grid-template-columns:2fr 1fr;gap:1rem;margin:1.5rem 0}.audit-controls label{display:grid;gap:.4rem;font-weight:700}.audit-controls input,.audit-controls select{padding:.7rem;border:1px solid #aaa;border-radius:.35rem;background:white}td{min-width:10rem;vertical-align:top}td:nth-child(4),td:nth-child(5),td:nth-child(6){min-width:20rem}@media(max-width:700px){.audit-controls{grid-template-columns:1fr}}</style>
