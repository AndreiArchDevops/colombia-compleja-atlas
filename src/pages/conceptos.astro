---
import Base from '../layouts/Base.astro'; import { concepts } from '../data/book';
---
<Base title="Conceptos · Colombia compleja"><section class="chapter-hero"><div class="wrap"><p class="eyebrow">Glosario contextual</p><h1>Ideas en relación</h1><p class="lede">Definiciones editoriales de trabajo: orientan la lectura, pero no reemplazan las formulaciones completas del libro.</p><label class="sr-only" for="concept-search">Buscar concepto</label><input id="concept-search" class="search" type="search" placeholder="Buscar por concepto o definición…"/></div></section><section class="section"><div class="wrap grid two">{concepts.map(c=><article class="card search-item" data-search={`${c.name} ${c.definition} ${c.related.join(' ')}`.toLowerCase()}><p class="eyebrow">{c.chapterIds.join(' · ')}</p><h2>{c.name}</h2><p>{c.definition}</p><div class="tag-list">{c.related.map(r=><span class="pill">↔ {r}</span>)}</div></article>)}</div></section><script>const input=document.querySelector<HTMLInputElement>('#concept-search');input?.addEventListener('input',()=>document.querySelectorAll<HTMLElement>('.search-item').forEach(x=>x.hidden=!x.dataset.search!.includes(input.value.toLowerCase())));</script></Base>
