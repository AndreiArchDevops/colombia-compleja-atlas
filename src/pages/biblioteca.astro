---
import Base from '../layouts/Base.astro'; import { sources } from '../data/book'; import { linkAudit } from '../data/linkAudit'; import { media } from '../data/media'; import { withBase } from '../utils/paths';
const states=[...new Set(linkAudit.map(x=>x.state))];
---
<Base title="Biblioteca ampliada · Colombia compleja"><section class="chapter-hero"><div class="wrap"><nav class="breadcrumbs" aria-label="Migas"><ol><li><a href={withBase()}>Inicio</a></li><li aria-current="page">Biblioteca</li></ol></nav><p class="eyebrow">Fuentes y auditoría bibliográfica</p><h1>Biblioteca ampliada</h1><p class="lede">Enlaces del libro, fuentes de contraste y alternativas institucionales, con estado y fecha de consulta.</p></div></section>
<section class="section"><div class="wrap"><h2>Filtrar enlaces del libro</h2><div class="filters" role="group" aria-label="Filtrar por estado"><button class="filter-button" data-link-filter="all" aria-pressed="true">Todos ({linkAudit.length})</button>{states.map(s=><button class="filter-button" data-link-filter={s} aria-pressed="false">{s}</button>)}</div><label class="sr-only" for="library-search">Buscar referencia</label><input class="search" id="library-search" type="search" placeholder="Buscar autor, obra o institución…" style="margin-top:1rem"/><div class="grid two" style="margin-top:1rem">{linkAudit.map(x=><article class="card library-item" data-state={x.state} data-search={`${x.reference} ${x.section}`.toLowerCase()}><span class="status">{x.state}</span><h3>{x.reference}</h3><p>Edición 2014: p. {x.printedPage} · PDF: p. {x.pdfPage}</p><p>{x.result}</p>{x.originalUrl&&(x.originalUrl.startsWith('http')?<p><a href={x.originalUrl} rel="external nofollow">URL citada ↗</a></p>:<p><code>{x.originalUrl}</code></p>)}{x.alternativeUrl&&<p><a href={x.alternativeUrl} rel="external">Alternativa verificada ↗</a></p>}<small>HTTP {x.http||'—'} · redirecciones {x.redirects??'—'} · consulta {x.checked}</small></article>)}</div><p><a href={withBase('reports/link-audit.csv')}>Descargar CSV</a> · <a href="https://github.com/AndreiArchDevops/colombia-compleja-atlas/blob/feature/fase-2-lectura-interactiva/reports/link-audit.md">Leer metodología del informe</a></p></div></section>
<section class="section"><div class="wrap"><h2>Fuentes del atlas</h2><ul class="source-list">{sources.map(s=><li><span class="pill">{s.kind}</span><h3><a href={s.url} rel="external">{s.title}</a></h3><p>{s.author}. {s.publisher}{s.published?`, ${s.published}`:''}. Consulta: {s.accessed}.</p>{s.notes&&<p><small>{s.notes}</small></p>}</li>)}</ul></div></section>
<section class="section" id="mediateca"><div class="wrap"><p class="eyebrow">Licencias verificadas</p><h2>Biblioteca visual</h2><p class="lede">Cada imagen publicada conserva autoría, procedencia, licencia, transformación, relación pedagógica y texto alternativo. Los recursos pendientes se muestran sin reproducir.</p><div class="media-grid">{media.map(item=><article class="media-card card">{item.localPath?<figure><img src={withBase(item.localPath.replace(/^\//,''))} alt={item.alt} loading="lazy" decoding="async"/><figcaption>{item.description}</figcaption></figure>:<div class="media-placeholder" role="img" aria-label="Recurso no publicado por falta de licencia verificable">Licencia pendiente</div>}<span class="status">{item.license}</span><h3>{item.title}</h3><p><strong>Autor:</strong> {item.author}</p><p>{item.relation}</p>{item.transformation&&<p><small><strong>Transformación:</strong> {item.transformation}</small></p>}{item.sourceUrl&&<p><a href={item.sourceUrl} rel="external">Ficha original y metadatos ↗</a></p>}{item.licenseUrl&&<p><a href={item.licenseUrl} rel="license">Texto de la licencia ↗</a></p>}<small>Capítulos: {item.chapterIds.length?item.chapterIds.map(x=>x.replace('c','')).join(', '):'pendiente'}</small></article>)}</div></div></section>
<script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-link-filter]');const input=document.querySelector<HTMLInputElement>('#library-search');const apply=()=>{const active=document.querySelector<HTMLButtonElement>('[data-link-filter][aria-pressed="true"]')?.dataset.linkFilter||'all';const q=input?.value.toLowerCase()||'';document.querySelectorAll<HTMLElement>('.library-item').forEach(x=>x.hidden=(active!=='all'&&x.dataset.state!==active)||!x.dataset.search!.includes(q))};buttons.forEach(b=>b.addEventListener('click',()=>{buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));apply()}));input?.addEventListener('input',apply);</script></Base>
