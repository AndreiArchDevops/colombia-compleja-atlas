---
import Base from '../layouts/Base.astro';
import DocumentLibrary from '../components/DocumentLibrary.astro';
import { documentLibrary } from '../data/documentLibrary';
import { linkAudit } from '../data/linkAudit';
import { media } from '../data/media';
import { withBase } from '../utils/paths';

const visualArchive = documentLibrary.filter(record => record.imageUrl);
const auditCounts = [...new Set(linkAudit.map(record=>record.state))].map(state=>({state,count:linkAudit.filter(record=>record.state===state).length}));
---
<Base title="Biblioteca documental · Colombia compleja">
  <section class="chapter-hero"><div class="wrap"><nav class="breadcrumbs" aria-label="Migas"><ol><li><a href={withBase()}>Inicio</a></li><li aria-current="page">Biblioteca</li></ol></nav><p class="eyebrow">Documentos, historia y territorio</p><h1>Biblioteca de investigación</h1><p class="lede">Obras citadas, documentos originales, mapas y fuentes relacionadas, distinguidos por procedencia, acceso y función dentro del atlas.</p><div class="meta-row"><span class="pill">{documentLibrary.length} fichas documentales</span><span class="pill">{visualArchive.length} reproducciones históricas</span><span class="pill">{linkAudit.length} enlaces auditados</span></div></div></section>

  <section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Antes de buscar</p><h2>Cuatro relaciones que no significan lo mismo</h2></div><p>Una obra citada puede no estar digitalizada. Un catálogo confirma identidad bibliográfica, no contenido. Un material relacionado ayuda a contrastar, pero no sustituye el original. “Documento localizado” exige coincidencia de autor, título y edición o una explicación explícita de la diferencia.</p></div><div class="grid relation-grid"><article class="card"><span class="status">obra citada</span><h3>Está en el PDF</h3><p>La ficha conserva su forma bibliográfica y página. Puede carecer de URL o requerir suscripción.</p></article><article class="card"><span class="status">documento original localizado</span><h3>Coincidencia comprobada</h3><p>El enlace conduce a la obra exacta o a su ficha institucional inequívoca.</p></article><article class="card"><span class="status">catálogo bibliográfico</span><h3>Identifica, no reproduce</h3><p>Confirma metadatos sin afirmar acceso al texto o licencia de reutilización.</p></article><article class="card"><span class="status">material relacionado</span><h3>Sirve para contraste</h3><p>Actualiza o contextualiza, pero no se presenta como la fuente usada por Carrizosa.</p></article></div></div></section>

  <section class="section" id="catalogo"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Consulta interconectada</p><h2>Explorar el corpus</h2></div><p>Combina búsqueda libre con filtros por naturaleza, relación documental, tema, región y sección. Cada ficha conduce al capítulo, apéndice, contraste o sistema territorial donde aporta contexto.</p></div><DocumentLibrary /></div></section>

  <section class="section" id="archivo-visual"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Dominio público documentado</p><h2>Archivo cartográfico visual</h2></div><p>Estas reproducciones se sirven mediante IIIF desde la Biblioteca Virtual del Banco de la República. Son mapas históricos: muestran categorías, fronteras y conocimientos de su tiempo, no límites contemporáneos.</p></div><div class="media-strip">{visualArchive.map(record=><figure class="card"><img src={record.imageUrl} alt={`Reproducción del mapa histórico ${record.title}, ${record.year}.`} loading="lazy" decoding="async" referrerpolicy="no-referrer"/><figcaption><h3>{record.title}</h3><p>{record.attribution}</p><p><strong>Derechos:</strong> {record.rights}</p><p><small><strong>Transformación:</strong> {record.transformation}</small></p><a href={record.url}>Ficha, imagen completa y metadatos ↗</a> · <a href={`#${record.id}`}>Ficha del atlas</a></figcaption></figure>)}</div></div></section>

  <section class="section" id="auditoria-enlaces"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Control de acceso</p><h2>Auditoría de enlaces del PDF</h2></div><p>El código HTTP describe una prueba, no la existencia intelectual de la obra. Un 403, 429, 503 o timeout se conserva como bloqueo/no comprobable; únicamente una comprobación individual justifica marcar una ruta como rota.</p></div><div class="tag-list">{auditCounts.map(item=><span class="pill">{item.state}: {item.count}</span>)}</div><details class="audit-panel"><summary>Ver los {linkAudit.length} registros técnicos</summary><div class="table-scroll" tabindex="0" role="region" aria-label="Auditoría técnica de enlaces bibliográficos"><table><thead><tr><th>Referencia</th><th>Ubicación</th><th>Estado</th><th>Resultado</th><th>Acceso</th></tr></thead><tbody>{linkAudit.map(record=><tr><th scope="row">{record.reference}</th><td>p. {record.printedPage}<br/><small>PDF {record.pdfPage}</small></td><td><span class="status">{record.state}</span><br/><small>HTTP {record.http||'—'}</small></td><td>{record.result}<br/><small>Consulta {record.checked}</small></td><td>{record.originalUrl&&record.originalUrl.startsWith('http')&&<a href={record.originalUrl} rel="external nofollow">URL citada</a>}{record.alternativeUrl&&<><br/><a href={record.alternativeUrl} rel="external">Alternativa verificada</a></>}</td></tr>)}</tbody></table></div></details><p><a href={withBase('reports/link-audit.csv')}>Descargar auditoría CSV</a></p></div></section>

  <section class="section" id="mediateca"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Fotografías y reproducciones</p><h2>Biblioteca visual existente</h2></div><p>Se conserva la mediateca auditada. Un recurso sin licencia comprobada permanece como registro pendiente y no se reproduce.</p></div><div class="media-grid">{media.map(item=><article class="media-card card">{item.localPath?<figure><img src={withBase(item.localPath.replace(/^\//,''))} alt={item.alt} loading="lazy" decoding="async"/><figcaption>{item.description}</figcaption></figure>:<div class="media-placeholder" role="img" aria-label="Recurso no publicado por falta de licencia verificable">Licencia pendiente</div>}<span class="status">{item.license}</span><h3>{item.title}</h3><p><strong>Autor:</strong> {item.author}</p><p>{item.relation}</p>{item.transformation&&<p><small><strong>Transformación:</strong> {item.transformation}</small></p>}{item.sourceUrl&&<p><a href={item.sourceUrl} rel="external">Ficha original y metadatos ↗</a></p>}{item.licenseUrl&&<p><a href={item.licenseUrl} rel="license">Texto de la licencia ↗</a></p>}<small>Capítulos: {item.chapterIds.length?item.chapterIds.map(id=>id.replace('c','')).join(', '):'pendiente'}</small></article>)}</div></div></section>
</Base>

<style>.relation-grid{grid-template-columns:repeat(4,1fr)}.audit-panel{margin-top:1rem}.audit-panel>summary{cursor:pointer;font-weight:800;padding:1rem;background:var(--card);border:1px solid var(--line)}.audit-panel table{margin-top:1rem;min-width:900px}.audit-panel th,.audit-panel td{vertical-align:top}.media-strip figure img{aspect-ratio:4/3}.media-strip figcaption h3{margin-top:0}@media(max-width:900px){.relation-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.media-strip,.relation-grid{grid-template-columns:1fr}}</style>
