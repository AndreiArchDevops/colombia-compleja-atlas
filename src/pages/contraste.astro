---
import Base from '../layouts/Base.astro';
import { chapters, claims, sources } from '../data/book';
import { appendices } from '../data/learning';

const statusLabels = { confirmada:'Confirmada', parcial:'Parcialmente confirmada', controvertida:'Controvertida', refutada:'Refutada', 'no-verificable':'No verificable', interpretacion:'Interpretación' };
const kindLabels = { 'dato-historico':'Dato histórico', 'dato-cientifico':'Dato científico', interpretacion:'Interpretación del autor', 'hipotesis-causal':'Hipótesis causal', 'valoracion-normativa':'Valoración normativa', 'actualizacion-posterior':'Actualización posterior' };
const statuses = [...new Set(claims.map(c => c.status))];
const kinds = [...new Set(claims.map(c => c.kind))];
const statusCounts = statuses.map(status => ({ status, count: claims.filter(c => c.status === status).length }));
const maxCount = Math.max(...statusCounts.map(x => x.count));
---
<Base title="Historia contrastada · Colombia compleja">
  <section class="chapter-hero"><div class="wrap">
    <p class="eyebrow">Historia contrastada</p><h1>Afirmación, evidencia, límite</h1>
    <p class="lede">{claims.length} fichas auditables distinguen lo que el libro afirma, lo que una fuente permite confirmar y lo que todavía no sabemos.</p>
    <div class="notice"><strong>Regla temporal:</strong> una actualización de 2026 no vuelve falsa una cifra publicada en 2014. Comparamos fecha, escala, categoría y método antes de clasificar.</div>
  </div></section>

  <section class="section"><div class="wrap">
    <h2>Estado del corpus</h2>
    <div class="claim-chart" role="img" aria-label={`Distribución de ${claims.length} fichas por resultado`}>
      {statusCounts.map(x => <div class="chart-row"><span>{statusLabels[x.status]}</span><div class="chart-track"><i style={`width:${Math.max(5, x.count / maxCount * 100)}%`}></i></div><strong>{x.count}</strong></div>)}
    </div>
    <p class="caption">Visualización reproducible calculada directamente desde <code>src/data/claims.ts</code>.</p>
  </div></section>

  <section class="section"><div class="wrap">
    <div class="audit-controls" aria-label="Filtrar fichas de contraste">
      <label>Buscar <input id="claim-search" type="search" placeholder="agua, censo, territorio…" /></label>
      <label>Resultado <select id="status-filter"><option value="all">Todos</option>{statuses.map(s => <option value={s}>{statusLabels[s]}</option>)}</select></label>
      <label>Tipo <select id="kind-filter"><option value="all">Todos</option>{kinds.map(k => <option value={k}>{kindLabels[k]}</option>)}</select></label>
      <label>Sección <select id="chapter-filter"><option value="all">Todas</option>{chapters.map(c => <option value={c.id}>{c.number}. {c.title}</option>)}{appendices.map((a,i) => <option value={a.id}>Apéndice {i+1}. {a.title}</option>)}</select></label>
    </div>
    <p id="filter-result" class="caption" aria-live="polite">Mostrando {claims.length} fichas.</p>
    <div class="claim-list">
      {claims.map(c => {
        const chapter = chapters.find(x => x.id === c.chapterId);
        const appendixIndex = appendices.findIndex(x => x.id === c.chapterId);
        return <article class="card claim filterable" data-status={c.status} data-kind={c.kind} data-chapter={c.chapterId} data-search={`${c.statement} ${c.context} ${c.evidence}`.toLowerCase()}>
          <div class="claim-meta"><span class="status">{statusLabels[c.status]}</span><span>{kindLabels[c.kind]}</span><span>{chapter ? `Cap. ${chapter.number}` : `Apéndice ${appendixIndex + 1}`} · p. {c.page}</span></div>
          <h3>{c.statement}</h3>
          <p><strong>Contexto en el libro.</strong> {c.context}</p>
          <details><summary>Ver expediente documental</summary>
            <dl class="evidence-grid">
              <div><dt>Evidencia externa</dt><dd>{c.evidence}</dd></div>
              <div><dt>Resultado editorial</dt><dd>{c.assessment}</dd></div>
              <div><dt>Fecha de los datos</dt><dd>{c.dataDate}</dd></div>
              <div><dt>Limitaciones</dt><dd>{c.limitations}</dd></div>
              <div><dt>Confianza</dt><dd>{c.confidence}</dd></div>
              <div><dt>Última revisión</dt><dd>{c.reviewed}</dd></div>
            </dl>
            <h4>Fuentes</h4><ul>{c.sourceIds.map(id => { const s=sources.find(x=>x.id===id); return <li><a href={s?.url} target="_blank" rel="noreferrer">{s?.title}</a>{s?.published && ` (${s.published})`}</li> })}</ul>
          </details>
        </article>;
      })}
    </div>
  </div></section>

  <script>
    const controls = ['claim-search','status-filter','kind-filter','chapter-filter'].map(id => document.getElementById(id));
    const update = () => {
      const query = (document.querySelector<HTMLInputElement>('#claim-search')?.value || '').trim().toLowerCase();
      const status = document.querySelector<HTMLSelectElement>('#status-filter')?.value;
      const kind = document.querySelector<HTMLSelectElement>('#kind-filter')?.value;
      const chapter = document.querySelector<HTMLSelectElement>('#chapter-filter')?.value;
      let visible = 0;
      document.querySelectorAll<HTMLElement>('.filterable').forEach(card => {
        const show = (!query || card.dataset.search?.includes(query)) && (status === 'all' || card.dataset.status === status) && (kind === 'all' || card.dataset.kind === kind) && (chapter === 'all' || card.dataset.chapter === chapter);
        card.hidden = !show; if (show) visible++;
      });
      const result = document.querySelector('#filter-result'); if (result) result.textContent = `Mostrando ${visible} fichas.`;
    };
    controls.forEach(control => { control?.addEventListener('input', update); control?.addEventListener('change', update); });
  </script>
</Base>

<style>
  .notice{max-width:72ch;margin-top:1.2rem;padding:1rem 1.2rem;border-left:4px solid var(--accent,#9b4d2c);background:var(--paper-2,#f3eee5)}
  .claim-chart{max-width:760px}.chart-row{display:grid;grid-template-columns:minmax(10rem,1fr) 3fr 2rem;gap:.75rem;align-items:center;margin:.65rem 0}.chart-track{height:.7rem;background:#e4ded3;border-radius:1rem;overflow:hidden}.chart-track i{display:block;height:100%;background:#2f6759;border-radius:inherit}
  .audit-controls{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:1rem;align-items:end}.audit-controls label{display:grid;gap:.35rem;font-weight:700}.audit-controls input,.audit-controls select{width:100%;padding:.7rem;border:1px solid #a9a092;border-radius:.35rem;background:white;color:inherit}
  .claim-list{display:grid;gap:1rem;margin-top:1rem}.claim-meta{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center}.claim-meta>span:not(.status){font-size:.85rem;color:var(--muted,#625d55)}details{margin-top:.8rem}summary{cursor:pointer;font-weight:700}.evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1rem 0}.evidence-grid div{border-top:1px solid #d8d0c4;padding-top:.65rem}.evidence-grid dt{font-weight:700}.evidence-grid dd{margin:.3rem 0 0}.caption{color:var(--muted,#625d55);font-size:.9rem}
  @media(max-width:760px){.audit-controls,.evidence-grid{grid-template-columns:1fr}.chart-row{grid-template-columns:8rem 1fr 1.5rem}.claim{padding:1rem}}
</style>
