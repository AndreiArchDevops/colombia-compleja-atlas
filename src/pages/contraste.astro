---
import Base from '../layouts/Base.astro'; import { claims, sources } from '../data/book'; const labels={confirmada:'Confirmada',parcial:'Parcialmente confirmada',controvertida:'Controvertida',refutada:'Refutada','no-verificable':'No verificable',interpretacion:'Interpretación'};
---
<Base title="Historia contrastada · Colombia compleja"><section class="chapter-hero"><div class="wrap"><p class="eyebrow">Historia contrastada</p><h1>Afirmación, evidencia, límite</h1><p class="lede">Un registro auditable que evita convertir interpretaciones en hechos.</p></div></section><section class="section"><div class="wrap"><div class="filters" role="group" aria-label="Filtrar estados"><button class="filter-button" data-filter="all" aria-pressed="true">Todas</button>{[...new Set(claims.map(c=>c.status))].map(s=><button class="filter-button" data-filter={s} aria-pressed="false">{labels[s]}</button>)}</div><div class="grid two" style="margin-top:1rem">{claims.map(c=><article class="card claim filterable" data-status={c.status}><span class="status">{labels[c.status]}</span><h3>{c.statement}</h3><p>{c.assessment}</p><p><small>Libro: p. {c.page} · Confianza: {c.confidence} · Revisado: {c.reviewed}</small></p><ul>{c.sourceIds.map(id=>{const s=sources.find(x=>x.id===id);return <li><a href={s?.url}>{s?.title}</a></li>})}</ul></article>)}</div></div></section><script>document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.addEventListener('click',()=>{const f=b.dataset.filter;document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelectorAll<HTMLElement>('.filterable').forEach(x=>x.hidden=f!=='all'&&x.dataset.status!==f)}));</script></Base>
