---
import Base from '../../layouts/Base.astro';
import ReaderTools from '../../components/ReaderTools.astro';
import { appendices } from '../../data/learning';
import { deepChapters } from '../../data/deepResearch';
import { media } from '../../data/media';
import { withBase } from '../../utils/paths';

export function getStaticPaths(){
  return appendices.map(appendix=>({params:{id:appendix.id},props:{appendix}}));
}
const {appendix}=Astro.props;
const deep=deepChapters[appendix.id]!;
const appendixMedia=media.filter(item=>deep.mediaIds.includes(item.id)&&item.localPath);
const idx=appendices.findIndex(item=>item.id===appendix.id);
const prev=appendices[idx-1]; const next=appendices[idx+1];
---
<Base title={`${appendix.title} · Colombia compleja`}>
  <section class="chapter-hero"><div class="wrap">
    <nav class="breadcrumbs" aria-label="Migas"><ol><li><a href={withBase()}>Inicio</a></li><li><a href={withBase('libro/')}>El libro</a></li><li aria-current="page">Apéndice {idx+1}</li></ol></nav>
    <p class="eyebrow">Apéndice {idx+1} · pp. {appendix.pages}</p><h1>{appendix.title}</h1><p class="lede">{appendix.summary}</p><span class="status">Lectura profunda cotejada con el PDF</span>
  </div></section>
  <section class="section"><div class="wrap chapter-layout"><article>
    <section id="lectura"><p class="eyebrow">Fase 3 · lectura directa</p><h2>Explicación desarrollada</h2><p class="notice">{deep.scope}</p>{deep.explanation.map(p=><p>{p}</p>)}</section>
    <section id="estructura"><h2>Estructura y argumentos</h2><div class="deep-sections">{deep.sections.map((section,i)=><article class="card"><span class="card-number">{String(i+1).padStart(2,'0')} · pp. {section.pages}</span><h3>{section.title}</h3><p>{section.argument}</p><h4>Casos y ejemplos</h4><ul>{section.examples.map(example=><li>{example}</li>)}</ul></article>)}</div></section>
    <section id="vocabulario"><h2>Vocabulario de trabajo</h2><dl class="vocabulary-grid">{deep.vocabulary.map(item=><div class="card"><dt>{item.term}</dt><dd>{item.definition}</dd></div>)}</dl></section>
    <section id="limites"><h2>Supuestos y limitaciones</h2><ul>{deep.assumptions.map(item=><li>{item}</li>)}</ul><div class="grid two"><article class="card"><h3>Conclusiones</h3><ul>{deep.conclusions.map(item=><li>{item}</li>)}</ul></article><article class="card"><h3>Preguntas abiertas</h3><ul>{deep.openQuestions.map(item=><li>{item}</li>)}</ul></article></div></section>
    {appendixMedia.length>0&&<section id="paisajes"><h2>Paisajes para contrastar la teoría</h2><p>Estas imágenes ilustran configuraciones territoriales; no prueban por sí mismas los argumentos.</p><div class="media-strip">{appendixMedia.map(item=><figure class="card"><img src={withBase(item.localPath.replace(/^\//,''))} alt={item.alt} loading="lazy" decoding="async"/><figcaption><strong>{item.title}</strong><br/>{item.relation}<br/><small>{item.author} · <a href={item.sourceUrl}>{item.license}</a></small></figcaption></figure>)}</div></section>}
    <section id="recuperacion"><p class="eyebrow">Recuperación activa</p><h2>Recuerda antes de revelar</h2><div class="grid">{deep.retrieval.map((item,i)=><details class="card recall-card"><summary>{i+1}. {item.question}</summary><p><strong>Respuesta orientativa:</strong> {item.answer}</p></details>)}</div></section>
    <nav class="chapter-nav" aria-label="Entre apéndices">{prev?<a class="button secondary" href={withBase(`apendices/${prev.id}/`)}>← {prev.title}</a>:<a class="button secondary" href={withBase('capitulos/c8/')}>← Capítulo VIII</a>}{next?<a class="button" href={withBase(`apendices/${next.id}/`)}>{next.title} →</a>:<a class="button" href={withBase('libro/')}>Volver al libro</a>}</nav>
  </article><aside><div class="card sticky-card"><p class="eyebrow">En esta página</p><nav class="toc" aria-label="Tabla de contenidos"><a href="#lectura">Explicación</a><a href="#estructura">Estructura</a><a href="#vocabulario">Vocabulario</a><a href="#limites">Límites</a>{appendixMedia.length>0&&<a href="#paisajes">Paisajes</a>}<a href="#recuperacion">Recuperación activa</a></nav></div><ReaderTools id={appendix.id}/></aside></div></section>
</Base>
