---
import Base from '../layouts/Base.astro'; import { chapters } from '../data/book'; import { keyIdeas, summary250, advancedSummary } from '../data/learning'; import { withBase } from '../utils/paths';
---
<Base title="Rutas de estudio · Colombia compleja"><section class="chapter-hero"><div class="wrap"><nav class="breadcrumbs" aria-label="Migas"><ol><li><a href={withBase()}>Inicio</a></li><li aria-current="page">Rutas de estudio</li></ol></nav><p class="eyebrow">Elige tiempo y profundidad</p><h1>Tres formas de entrar</h1><p class="lede">Todas llegan al mismo libro; cambia el ritmo, la cantidad de contexto y el tipo de preguntas.</p></div></section>
<section class="section" id="rapida"><div class="wrap"><p class="eyebrow">15 minutos orientativos</p><h2>Ruta rápida</h2><div class="grid two"><div><p>{summary250}</p><a class="button" href={withBase('atlas/#mapa-conceptual')}>Ver mapa conceptual</a></div><ol>{keyIdeas.map(x=><li>{x}</li>)}</ol></div></div></section>
<section class="section" id="guiada"><div class="wrap"><p class="eyebrow">60 minutos orientativos</p><h2>Ruta guiada capítulo a capítulo</h2><div class="grid">{chapters.map(c=><article class="card"><span class="card-number">CAP. {c.number} · 6–8 MIN</span><h3>{c.title}</h3><p>{c.initial}</p><a href={withBase(`capitulos/${c.id}/#minuto`)}>Leer y responder →</a></article>)}</div></div></section>
<section class="section" id="avanzada"><div class="wrap prose-wide"><p class="eyebrow">Sin límite de tiempo</p><h2>Ruta avanzada</h2><p>{advancedSummary}</p><div class="actions"><a class="button" href={withBase('contraste/')}>Examinar verificaciones</a><a class="button secondary" href={withBase('biblioteca/')}>Abrir fuentes</a><a class="button secondary" href={withBase('metodologia/')}>Revisar método</a></div></div></section></Base>
