---
import Base from '../layouts/Base.astro'; import { book, chapters, passages } from '../data/book';
import { summary250, summaryLong, advancedSummary, bigQuestions, appendices } from '../data/learning'; import { withBase } from '../utils/paths';
---
<Base title="El libro · Colombia compleja"><section class="chapter-hero"><div class="wrap"><nav class="breadcrumbs" aria-label="Migas"><ol><li><a href={withBase()}>Inicio</a></li><li aria-current="page">El libro</li></ol></nav><p class="eyebrow">La obra</p><h1>{book.title}</h1><p class="lede">Ficha bibliográfica, estructura argumental y tres niveles de resumen.</p></div></section>
<section class="section"><div class="wrap grid two"><div class="card"><h2>Ficha verificada</h2><dl><dt>Autor</dt><dd>{book.author}</dd><dt>Edición</dt><dd>{book.year}, Bogotá</dd><dt>Entidades editoras</dt><dd>{book.publishers.join('; ')}</dd><dt>ISBN catalogado</dt><dd>{book.isbn}</dd><dt>Extensión</dt><dd>{book.pagesCatalogued} páginas catalogadas; {book.pdfPages} en el PDF</dd></dl><p class="notice">{book.note}</p></div><div class="card"><h2>Arquitectura</h2><p>El recorrido avanza de imaginarios y población a estructura física; estudia luego interrelaciones y sistemas territoriales; finalmente plantea la diferencia colombiana, examina estrategias y abre posibilidades de futuro.</p><a class="button" href="https://sogeocol.edu.co/Catalogo/Colombia-compleja.pdf" rel="external">Consultar PDF autorizado ↗</a></div></div></section>
<section class="section" id="resumenes"><div class="wrap prose-wide"><p class="eyebrow">Tres profundidades</p><h2 id="resumen">Resumen esencial · 250 palabras</h2>{summary250.split('\n').map(p=><p>{p}</p>)}<details><summary><strong>Resumen desarrollado · aproximadamente 1000 palabras</strong></summary>{summaryLong.map(p=><p>{p}</p>)}</details><details><summary><strong>Lectura avanzada: argumento, método y límites</strong></summary><p>{advancedSummary}</p></details></div></section>
<section class="section"><div class="wrap"><h2>Índice analítico</h2><div class="grid">{chapters.map(c=><article class="card"><span class="card-number">{c.printedStart}–{c.printedEnd}</span><h3>{c.title}</h3><p>{c.thesis}</p><a href={withBase(`capitulos/${c.id}/`)}>Abrir módulo →</a></article>)}</div><h2 style="margin-top:3rem">Apéndices</h2><div class="grid two">{appendices.map(a=><article class="card"><span class="card-number">pp. {a.pages}</span><h3>{a.title}</h3><p>{a.summary}</p><div class="tag-list">{a.sections.map(s=><span class="pill">{s}</span>)}</div><p><a href={withBase(`apendices/${a.id}/`)}>Abrir lectura profunda →</a></p></article>)}</div></div></section>
<section class="section"><div class="wrap grid two"><div><p class="eyebrow">Preguntas mayores</p><h2>Lo que el libro deja abierto</h2><ol>{bigQuestions.map(q=><li>{q}</li>)}</ol></div><div><p class="eyebrow">Pasajes</p>{passages.map(p=><article class="card"><blockquote class="quote">{p.quote}</blockquote><p>Edición 2014, p. {p.page}. {p.context}</p></article>)}</div></div></section></Base>
