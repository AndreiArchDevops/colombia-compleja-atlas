---
import Base from '../layouts/Base.astro'; import { quizzes } from '../data/book';
---
<Base title="Laboratorio de aprendizaje · Colombia compleja"><section class="chapter-hero"><div class="wrap"><p class="eyebrow">Aprender haciendo</p><h1>Laboratorio de lectura</h1><p class="lede">Comprueba ideas clave y recibe retroalimentación. Las respuestas quedan en tu navegador.</p></div></section><section class="section"><div class="wrap grid">{quizzes.map((q,i)=><article class="card quiz" data-answer={q.answer} data-explanation={q.explanation}><span class="card-number">PREGUNTA {i+1}</span><h3>{q.question}</h3>{q.options.map((o,j)=><button class="quiz-option" data-option={j}>{o}</button>)}<p class="quiz-feedback" aria-live="polite"></p></article>)}</div></section><script>document.querySelectorAll<HTMLElement>('.quiz').forEach((q,qi)=>q.querySelectorAll<HTMLButtonElement>('[data-option]').forEach(b=>b.addEventListener('click',()=>{const ok=b.dataset.option===q.dataset.answer;const f=q.querySelector<HTMLElement>('.quiz-feedback')!;f.textContent=`${ok?'Correcto.':'Revisa la idea.'} ${q.dataset.explanation}`;f.style.color=ok?'#27633f':'#8c3529';localStorage.setItem(`cc-quiz-${qi}`,String(ok))})));</script></Base>
