---
import Base from '../../layouts/Base.astro'; import DepthSelector from '../../components/DepthSelector.astro'; import ReaderTools from '../../components/ReaderTools.astro';
import { chapters, passages, claims, sources } from '../../data/book'; import { moduleDetails } from '../../data/learning'; import { deepChapters } from '../../data/deepResearch'; import { media } from '../../data/media'; import { withBase } from '../../utils/paths';
export function getStaticPaths(){return chapters.map(chapter=>({params:{id:chapter.id},props:{chapter}}));}
const {chapter}=Astro.props; const detail=moduleDetails[chapter.id]; const idx=chapters.findIndex(c=>c.id===chapter.id); const prev=chapters[idx-1]; const next=chapters[idx+1];
const chapterPassages=passages.filter(p=>p.chapterId===chapter.id); const chapterClaims=claims.filter(c=>c.chapterId===chapter.id);
const pdfUrl=sources.find(source=>source.id==='book-2014')!.url;
const deep=deepChapters[chapter.id]; const chapterMedia=deep?media.filter(m=>deep.mediaIds.includes(m.id)&&m.localPath):[];
const checks=[{q:`¿Cuál es el foco principal de “${chapter.title}”?`,a:detail.minute,answer:0,options:[detail.learn[0],'Memorizar fechas sin relaciones','Sustituir el libro por una explicación única']},{q:'¿Cómo debe leerse la tesis del módulo?',a:'Como una reconstrucción editorial apoyada en el texto, no como cita literal.',answer:1,options:['Como cita literal del autor','Como paráfrasis editorial trazable','Como dato estadístico actual']},{q:'¿Qué práctica corresponde a una lectura crítica?',a:'Distinguir argumentos, evidencia, interpretación y asuntos pendientes.',answer:2,options:['Aceptar toda generalización','Descartar toda síntesis','Distinguir tipos de afirmación']}];
---
<Base title={`${chapter.title} · Colombia compleja`}><section class="chapter-hero"><div class="wrap"><nav class="breadcrumbs" aria-label="Migas"><ol><li><a href={withBase()}>Inicio</a></li><li><a href={withBase('libro/')}>El libro</a></li><li aria-current="page">Capítulo {chapter.number}</li></ol></nav><p class="eyebrow">Capítulo {chapter.number} · pp. {chapter.printedStart}–{chapter.printedEnd}</p><h1>{chapter.title}</h1><p class="lede">{chapter.question}</p><span class="status">{deep?'Lectura profunda cotejada con el PDF':'Síntesis editorial revisable'}</span></div></section>
<section class="section"><div class="wrap chapter-layout"><article>
  <section id="aprender"><p class="eyebrow">Objetivos</p><h2>Qué aprenderás</h2><ul>{detail.learn.map(x=><li>{x}</li>)}</ul></section>
  <section id="minuto"><p class="eyebrow">Lectura rápida</p><h2>Resumen en un minuto</h2><p class="lede">{detail.minute}</p><p class="notice"><strong>Paráfrasis editorial:</strong> sintetiza el capítulo; no reproduce palabras del autor.</p></section>
  <section id="argumento"><h2>Argumento central</h2><p>{chapter.thesis}</p><DepthSelector chapter={chapter}/></section>
  <section id="apartados"><h2>Síntesis por apartados</h2>{detail.sections.map(s=><article class="card"><span class="card-number">pp. {s.pages}</span><h3>{s.title}</h3><p>{s.text}</p></article>)}</section>
  {deep&&<section id="lectura-profunda" class="deep-reading"><p class="eyebrow">Fase 3 · lectura directa</p><h2>Lectura profunda documentada</h2><p class="notice">{deep.scope}</p>{deep.explanation.map(p=><p>{p}</p>)}<h3>Estructura real y argumentos</h3><div class="deep-sections">{deep.sections.map((s,i)=><article class="card"><span class="card-number">{String(i+1).padStart(2,'0')} · pp. {s.pages}</span><h3>{s.title}</h3><p>{s.argument}</p><h4>Casos y ejemplos del tramo</h4><ul>{s.examples.map(x=><li>{x}</li>)}</ul></article>)}</div><h3>Supuestos y límites</h3><ul>{deep.assumptions.map(x=><li>{x}</li>)}</ul><div class="grid two"><div class="card"><h3>Conclusiones</h3><ul>{deep.conclusions.map(x=><li>{x}</li>)}</ul></div><div class="card"><h3>Preguntas abiertas</h3><ul>{deep.openQuestions.map(x=><li>{x}</li>)}</ul></div></div></section>}
  <section id="conceptos"><h2>Conceptos en lenguaje claro</h2><div class="grid two">{chapter.concepts.map(x=><article class="card"><h3>{x}</h3><p>{x==='complejidad'?'Atender diversidad, relaciones, escalas y cambio sin reducir todo a una causa.':`Concepto clave para seguir el argumento de “${chapter.title}”; consulta su definición contextual y relaciones.`}</p><a href={withBase(`conceptos/?q=${encodeURIComponent(x)}`)}>Abrir glosario →</a></article>)}</div></section>
  {deep&&<section id="vocabulario"><h2>Vocabulario especializado</h2><dl class="vocabulary-grid">{deep.vocabulary.map(x=><div class="card"><dt>{x.term}</dt><dd>{x.definition}</dd></div>)}</dl></section>}
  <section id="ejemplos"><h2>Ejemplos históricos y ambientales</h2><ul>{detail.examples.map(x=><li>{x}</li>)}</ul></section>
  {chapterPassages.length>0&&<section id="pasajes"><h2>Pasajes significativos</h2><p>Fragmentos breves para análisis crítico; el desarrollo se realiza mediante paráfrasis original.</p>{chapterPassages.map(p=><div class="card passage-card"><span class="pill">Cita directa breve · p. impresa {p.page}</span><blockquote class="quote">{p.quote}</blockquote>{p.paraphrase&&<p><strong>En otras palabras:</strong> {p.paraphrase}</p>}<p><strong>Contexto:</strong> {p.context}</p><p><strong>Por qué importa:</strong> {p.significance}</p><p><strong>Puede provocar:</strong> {p.emotion.join(', ')}.</p>{p.connections&&<div class="tag-list">{p.connections.map(x=><span class="pill">{x}</span>)}</div>}<p><a href={`${pdfUrl}#page=${p.page+1}`} rel="external">Abrir la página en el PDF autorizado ↗</a></p></div>)}</section>}
  {chapterMedia.length>0&&<section id="paisajes"><h2>Paisajes para pensar el capítulo</h2><div class="media-strip">{chapterMedia.map(item=><figure class="card"><img src={withBase(item.localPath.replace(/^\//,''))} alt={item.alt} loading="lazy" decoding="async"/><figcaption><strong>{item.title}</strong><br/>{item.relation}<br/><small>{item.author} · <a href={item.sourceUrl}>{item.license}</a></small></figcaption></figure>)}</div></section>}
  <section id="conexiones"><h2>Relaciones con la obra</h2><div class="tag-list">{chapter.connections.filter(id=>chapters.some(x=>x.id===id)).map(id=>{const c=chapters.find(x=>x.id===id);return <a class="pill" href={withBase(`capitulos/${id}/`)}>Cap. {c?.number}: {c?.title}</a>})}{chapter.connections.filter(id=>id.startsWith('a')).map(id=><a class="pill" href={withBase(`apendices/${id}/`)}>{id.toUpperCase()}: apéndice</a>)}</div></section>
  {chapterClaims.length>0&&<section id="evidencias"><h2>Evidencias y contraste</h2><p>Estas fichas separan la afirmación del libro, la evidencia externa y sus límites.</p>{chapterClaims.map(c=><div class="card claim" data-status={c.status}><span class="status">{c.status}</span> <small>{c.kind} · p. {c.page}</small><h3>{c.statement}</h3><p><strong>Evidencia:</strong> {c.evidence}</p><p><strong>Resultado:</strong> {c.assessment}</p><p><strong>Límite:</strong> {c.limitations}</p><p><a href={`${pdfUrl}#page=${c.page+1}`} rel="external">Volver a la página original ↗</a></p><ul>{c.sourceIds.map(id=>{const s=sources.find(x=>x.id===id);return <li><a href={s?.url}>{s?.title}</a>{s?.notes&&<small> — {s.notes}</small>}</li>})}</ul><small>Datos: {c.dataDate} · Confianza {c.confidence} · revisión {c.reviewed}</small></div>)}</section>}
  <section id="comprension"><h2>Comprueba tu comprensión</h2><div class="grid">{checks.map((q,i)=><article class="card quiz" data-answer={q.answer} data-explanation={q.a}><span class="card-number">PREGUNTA {i+1}</span><h3>{q.q}</h3>{q.options.map((o,j)=><button class="quiz-option" data-option={j}>{o}</button>)}<p class="quiz-feedback" aria-live="polite"></p></article>)}</div><div class="notice"><strong>Pregunta crítica avanzada:</strong> {detail.critical}</div></section>
  {deep&&<section id="recuperacion"><p class="eyebrow">Recuperación activa</p><h2>Recuerda antes de revelar</h2><p>Intenta responder sin volver al texto. Después abre la retroalimentación y corrige tu explicación.</p><div class="grid">{deep.retrieval.map((x,i)=><details class="card recall-card"><summary>{i+1}. {x.question}</summary><p><strong>Respuesta orientativa:</strong> {x.answer}</p></details>)}</div></section>}
  <section id="lecturas"><h2>Lecturas adicionales</h2><ul>{detail.readings.map(r=><li>{r} <a href={withBase('biblioteca/')}>buscar en la biblioteca</a></li>)}</ul></section>
  <nav class="chapter-nav" aria-label="Entre capítulos">{prev?<a class="button secondary" href={withBase(`capitulos/${prev.id}/`)}>← {prev.title}</a>:<span></span>}{next?<a class="button" href={withBase(`capitulos/${next.id}/`)}>{next.title} →</a>:<a class="button" href={withBase('libro/')}>Volver al libro</a>}</nav>
  </article><aside><div class="card sticky-card"><p class="eyebrow">En esta página</p><nav class="toc" aria-label="Tabla de contenidos"><a href="#aprender">Qué aprenderás</a><a href="#minuto">Resumen en un minuto</a><a href="#argumento">Argumento central</a><a href="#apartados">Apartados</a>{deep&&<a href="#lectura-profunda">Lectura profunda</a>}<a href="#conceptos">Conceptos</a>{deep&&<a href="#vocabulario">Vocabulario</a>}<a href="#ejemplos">Ejemplos</a>{chapterPassages.length>0&&<a href="#pasajes">Pasajes</a>}{chapterMedia.length>0&&<a href="#paisajes">Paisajes</a>}<a href="#conexiones">Conexiones</a>{chapterClaims.length>0&&<a href="#evidencias">Evidencias</a>}<a href="#comprension">Comprensión</a>{deep&&<a href="#recuperacion">Recuperación activa</a>}<a href="#lecturas">Lecturas</a></nav></div><ReaderTools id={chapter.id}/></aside></div></section>
<script>document.querySelectorAll<HTMLElement>('.quiz').forEach(q=>q.querySelectorAll<HTMLButtonElement>('[data-option]').forEach(b=>b.addEventListener('click',()=>{const ok=b.dataset.option===q.dataset.answer;const f=q.querySelector<HTMLElement>('.quiz-feedback')!;f.textContent=`${ok?'Correcto.':'Revisa la síntesis.'} ${q.dataset.explanation}`;f.style.color=ok?'#27633f':'#8c3529'})));localStorage.setItem('cc-last-chapter',location.pathname);const links=[...document.querySelectorAll<HTMLAnchorElement>('.toc a')];const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){links.forEach(a=>a.removeAttribute('aria-current'));document.querySelector<HTMLAnchorElement>(`.toc a[href="#${e.target.id}"]`)?.setAttribute('aria-current','location')}}),{rootMargin:'-20% 0px -70%'});links.forEach(a=>{const section=document.querySelector(a.hash);if(section)observer.observe(section)});</script></Base>
