---
import '../styles/global.css';
const { title = 'Colombia compleja', description = 'Atlas interactivo de lectura crítica de Colombia compleja, de Julio Carrizosa Umaña.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#174c3c"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/><title>{title}</title></head>
<body><a class="skip" href="#contenido">Saltar al contenido</a><header class="site-header"><div class="wrap nav"><a class="brand" href={base}>Colombia compleja</a><nav aria-label="Principal"><a href={`${base}libro/`}>El libro</a><a href={`${base}autor/`}>Autor</a><a href={`${base}contraste/`}>Contraste</a><a href={`${base}cronologia/`}>Cronología</a><a href={`${base}conceptos/`}>Conceptos</a><a href={`${base}laboratorio/`}>Laboratorio</a><a href={`${base}biblioteca/`}>Biblioteca</a><a href={`${base}metodologia/`}>Método</a></nav></div></header><main id="contenido"><slot /></main><footer class="footer"><div class="wrap"><p><strong>Atlas interactivo de lectura crítica</strong></p><p>Proyecto independiente, educativo y no afiliado al autor ni a las entidades editoras. Citas breves con fines de análisis; consulta siempre la edición original.</p><p><a href={`${base}metodologia/`}>Metodología y correcciones</a></p></div></footer><script is:inline>document.documentElement.dataset.js='true';</script></body></html>
