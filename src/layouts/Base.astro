---
import '../styles/global.css';
import '../styles/deep.css';
import { withBase } from '../utils/paths';
const { title = 'Colombia compleja', description = 'Atlas interactivo de lectura crítica de Colombia compleja, de Julio Carrizosa Umaña.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navItems = [
  ['libro/','El libro'],['rutas/','Rutas de estudio'],['autor/','Autor'],['contraste/','Contraste'],
  ['atlas/','Atlas'],['cronologia/','Cronología'],['conceptos/','Conceptos'],['laboratorio/','Laboratorio'],
  ['biblioteca/','Biblioteca'],['metodologia/','Método']
];
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#174c3c"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><link rel="canonical" href={canonical}/><link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml"/><title>{title}</title></head>
<body id="top"><a class="skip" href="#contenido">Saltar al contenido</a><div class="global-progress" aria-hidden="true"><span data-global-progress></span></div><header class="site-header"><div class="wrap nav"><a class="brand" href={withBase()}>Colombia compleja <small>Atlas de lectura</small></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><span aria-hidden="true">☰</span><span>Menú</span></button><nav id="main-nav" aria-label="Principal">{navItems.map(([path,label])=><a href={withBase(path)}>{label}</a>)}</nav></div></header><main id="contenido"><slot /></main><a class="back-top" href="#top" aria-label="Volver arriba">↑</a><footer class="footer"><div class="wrap footer-grid"><div><p><strong>Atlas interactivo de lectura crítica</strong></p><p>Proyecto independiente, educativo y no afiliado al autor ni a las entidades editoras.</p></div><div><p><a href={withBase('metodologia/')}>Metodología y correcciones</a></p><p><a href="https://sogeocol.edu.co/Catalogo/Colombia-compleja.pdf" rel="external">Consultar el PDF autorizado ↗</a></p></div></div></footer><script>const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector<HTMLElement>('#main-nav');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));nav?.toggleAttribute('data-open',!open)});const completed=Object.keys(localStorage).filter(k=>k.startsWith('cc-complete-')&&localStorage.getItem(k)==='true').length;const bar=document.querySelector<HTMLElement>('[data-global-progress]');if(bar)bar.style.width=`${Math.min(100,completed/8*100)}%`;</script></body></html>
